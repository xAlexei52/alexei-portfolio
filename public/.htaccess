# Copied into the export by `next build`, so it deploys with the site.
# Note: the deploy workflow excludes .htaccess from FTP *deletion*, not from
# upload — edits here still ship, but a hand-edit on the server survives too.

# Serve the Next.js static 404 page instead of the Apache default.
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  # Hashed filenames under _next/static are immutable by construction.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML must revalidate, otherwise a deploy is invisible to returning visitors.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Force HTTPS.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>
